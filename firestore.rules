rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Validation Blueprints
    function isValidJobApplication(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'company', 'status', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId == request.auth.uid 
        && data.title is string && data.title.size() <= 200
        && data.company is string && data.company.size() <= 200
        && data.status is string && data.status.size() <= 50
        && data.createdAt is number
        && data.updatedAt is number
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('url' in data) || (data.url is string && data.url.size() <= 1000));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email'])
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 100;
    }

    // Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().keys().size() <= 10;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
                     && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    match /applications/{applicationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidJobApplication(incoming())
        && isValidId(applicationId)
        && applicationId == incoming().id
        && incoming().keys().size() <= 40; 

      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && isValidJobApplication(incoming())
        && incoming().userId == existing().userId 
        && (
          incoming().diff(existing()).affectedKeys().hasAny(['status', 'title', 'company', 'notes', 'updatedAt', 'requirements', 'avgCompetency', 'avgInterest', 'overallScore', 'url', 'applicationDate', 'interviewMethod', 'interviewDate', 'interviewDate2', 'salaryTarget', 'salaryPosted', 'followUpDate', 'workArrangement', 'officeLocation'])
        );
      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
