{
  "entities": {
    "JobApplication": {
      "title": "Job Application",
      "description": "Represents a job application being tracked by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "string" },
        "interviewMethod": { "type": "string" },
        "interviewDate": { "type": "string" },
        "notes": { "type": "string" },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "competencyScore": { "type": "number" },
              "interestScore": { "type": "number" }
            }
          }
        },
        "avgCompetency": { "type": "number" },
        "avgInterest": { "type": "number" },
        "overallScore": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "title", "company", "status", "requirements", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Basic information about the user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "/applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "The job applications tracked by users."
    }
  }
}
